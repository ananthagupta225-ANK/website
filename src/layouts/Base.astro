---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { href, abs } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Appended to the canonical URL; defaults to the current path. */
  path?: string;
  /** Hide from search engines (e.g. the thank-you page). */
  noindex?: boolean;
  /** Extra JSON-LD objects to emit on this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, path, noindex = false, schema = [] } = Astro.props;

const canonical = path ? abs(path, Astro.site) : new URL(Astro.url.pathname, Astro.site).href;
const ogImage = abs('/images/og-default.png', Astro.site);
const year = new Date().getFullYear();

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': abs('/', Astro.site) + '#organisation',
  name: site.name,
  description: site.description,
  url: abs('/', Astro.site),
  telephone: site.phone,
  ...(site.emailIsPlaceholder ? {} : { email: site.email }),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.locality,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: site.serviceArea.split('&').map((a) => a.trim()),
  openingHours: site.hoursSchema,
  ...(site.social.length ? { sameAs: site.social.map((s) => s.href) } : {}),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#08244F" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organisation)}
    />
    {
      schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer year={year} />
  </body>
</html>
