---
/* A photograph slot.

   The redesign is photograph-driven, but licensed images are the owner's to
   supply. Rather than ship a broken <img>, or invent a stand-in that implies
   a workplace or client that was never verified, each slot degrades to a
   branded panel until the real file is dropped in.

   Supply a .jpg (or .png) at the documented path. If a .webp sibling exists
   it is served first automatically — see brief section 12. */
import { resolveImage } from '../lib/assets';
import { href } from '../lib/url';

interface Props {
  src: string;
  /** Required: describes the photograph for screen readers and search. */
  alt: string;
  /** CSS aspect-ratio, e.g. '4 / 3'. */
  ratio?: string;
  /** Above-the-fold images should load eagerly. */
  eager?: boolean;
  /** Shown on the fallback panel so it is obvious what belongs here. */
  label?: string;
  class?: string;
  /** object-position, for steering the crop. */
  focus?: string;
}

const {
  src,
  alt,
  ratio = '4 / 3',
  eager = false,
  label,
  class: className = '',
  focus = 'center',
} = Astro.props;

const image = resolveImage(src);
---

<figure
  class:list={['figure', className]}
  style={`--ratio:${ratio}; --focus:${focus};`}
  data-state={image ? 'photo' : 'pending'}
>
  {
    image ? (
      <picture>
        {image.webp && <source srcset={href(image.webp)} type="image/webp" />}
        <img
          src={href(image.src)}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          fetchpriority={eager ? 'high' : undefined}
        />
      </picture>
    ) : (
      <span class="figure__pending" role="img" aria-label={alt}>
        <span class="figure__grid" aria-hidden="true" />
        {label && <span class="figure__label">{label}</span>}
      </span>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--grey);
    z-index: 1;
  }

  .figure picture,
  .figure img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .figure img {
    object-fit: cover;
    object-position: var(--focus);
  }

  /* --- Fallback panel ---------------------------------------------------
     Brand-coloured and deliberately abstract: it reads as a designed panel,
     never as a photograph of something that was not verified. ----------- */
  .figure__pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    justify-items: center;
    background: linear-gradient(145deg, var(--navy) 0%, var(--navy-900) 100%);
    overflow: hidden;
  }

  .figure__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.055) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(120% 100% at 70% 0%, #000 0%, transparent 72%);
  }

  .figure__label {
    position: relative;
    max-width: 22ch;
    padding: 0 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #778fb4;
    line-height: 1.6;
  }

  .figure__pending::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 34%;
    height: 3px;
    background: var(--green);
  }
</style>
