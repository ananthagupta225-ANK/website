---
/* Renders the supplied ANK logo file when one is configured in src/data/site.ts.
   Until then it falls back to a plain typographic wordmark — the brief forbids
   redrawing or recreating the logo artwork, so nothing is invented here. */
import { site } from '../data/site';
import { href } from '../lib/url';
import { hasAsset } from '../lib/assets';

interface Props {
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;

// Only use the logo file once it actually exists in public/.
const logo = hasAsset(site.logo) ? site.logo : '';
---

{
  logo ? (
    <span class="logo-plate" data-variant={variant}>
      <img
        class="logo-img"
        src={href(logo)}
        width={site.logoWidth}
        height={site.logoHeight}
        alt={`${site.name} logo`}
      />
    </span>
  ) : (
    <span class="wordmark" data-variant={variant}>
      <span class="wordmark__ank">ANK</span>
      <span class="wordmark__rule" aria-hidden="true" />
      <span class="wordmark__sub">HR Services</span>
    </span>
  )
}

<style>
  /* Logo widths follow brief section 2:
     desktop 160–190px, tablet 140–160px, mobile 120–140px. */
  .logo-img {
    display: block;
    height: auto;
    width: 180px;
  }

  @media (max-width: 1020px) {
    .logo-img {
      width: 152px;
    }
  }

  @media (max-width: 560px) {
    .logo-img {
      width: 134px;
    }
  }

  /* The supplied logo is drawn for light backgrounds, and its navy elements
     have little contrast on the dark footer. Rather than recolour it — the
     brief forbids that — the dark variant sits the UNALTERED logo on a white
     plate. */
  .logo-plate {
    display: inline-block;
    line-height: 0;
  }

  .logo-plate[data-variant='light'] {
    background: #fff;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark__ank {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--navy);
  }

  .wordmark__rule {
    width: 1px;
    height: 1.35rem;
    background: var(--line-strong);
  }

  .wordmark__sub {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .wordmark[data-variant='light'] .wordmark__ank {
    color: #fff;
  }
  .wordmark[data-variant='light'] .wordmark__sub {
    color: var(--on-navy-muted);
  }
  .wordmark[data-variant='light'] .wordmark__rule {
    background: var(--on-navy-line);
  }
</style>
