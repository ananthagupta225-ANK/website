---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Watermark from '../../components/Watermark.astro';

const title = 'Why Choose ANK | ANK HR Services';
const description =
  'Why businesses work with ANK HR Services: comprehensive HR solutions, payroll expertise, compliance support, practical consulting and structured documentation.';

const reasons = [
  {
    n: '01',
    t: 'Comprehensive HR Solutions',
    d: 'Payroll, statutory compliance, HR operations, documentation, recruitment and workforce support — coordinated through a single point of contact rather than split across separate providers.',
  },
  {
    n: '02',
    t: 'Payroll Management Expertise',
    d: 'Structured monthly cycles, accurate inputs and consistent reporting, built around your existing approvals and salary structures rather than forcing a new process on your team.',
  },
  {
    n: '03',
    t: 'Statutory Compliance Support',
    d: 'PF, ESI, labour law, factory and establishment documentation organised against an agreed compliance calendar, so recurring dates and records do not get missed.',
  },
  {
    n: '04',
    t: 'Practical HR Consulting',
    d: 'Recommendations you can actually act on. We review how HR runs today and suggest changes that fit your workforce, your systems and the people who have to operate them.',
  },
  {
    n: '05',
    t: 'Structured Documentation',
    d: 'Employee records, registers, trackers and formats kept in order, so the right document can be produced quickly when an auditor, authority or manager asks for it.',
  },
  {
    n: '06',
    t: 'Reliable Client Coordination',
    d: 'Clear ownership of responsibilities, approvals and timelines on both sides, with communication you do not have to chase.',
  },
];
---

<Base title={title} description={description}>
  <PageHero
    label="Why ANK"
    title="A practical partner for HR and payroll processes"
    lead="What we offer is straightforward: organised processes, careful documentation and clear coordination, within a scope agreed with you in writing."
    breadcrumbs={[{ label: 'Why ANK' }]}
  />

  <section class="section has-watermark">
    <Watermark position="top-right" size={470} opacity={0.04} tone="navy" />
    <div class="container">
      <ul class="reasons" data-stagger>
        {
          reasons.map((r) => (
            <li class="reason" data-reveal="up">
              <span class="reason__num">{r.n}</span>
              <h2 class="reason__title">{r.t}</h2>
              <p class="reason__text">{r.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--grey has-watermark">
    <Watermark position="bottom-left" size={430} opacity={0.04} tone="navy" />
    <div class="container container--narrow">
      <p class="label">Being clear about what we offer</p>
      <h2>What we do not claim</h2>
      <div class="prose" style="margin-top:1.5rem;">
        <p>
          Statutory requirements vary by establishment, location, workforce and
          the law in force at the time. Because of that, we are deliberate about
          the promises we make:
        </p>
        <ul class="ticks" style="margin-top:1.25rem;">
          <li>
            We do not promise guaranteed compliance, zero errors or complete
            legal protection.
          </li>
          <li>
            We do not provide legal opinions. Where a legal determination is
            needed, we coordinate with your qualified professional advisers.
          </li>
          <li>
            We do not guarantee hiring outcomes. Selection decisions rest with
            the client.
          </li>
          <li>
            We do not publish client names, logos, testimonials or case studies
            without written permission.
          </li>
        </ul>
        <p>
          What we do commit to is an agreed scope, documented deliverables and
          clear communication about responsibilities on both sides.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }

  .reason {
    padding-top: 1.35rem;
    border-top: 2px solid var(--navy);
  }

  .reason__num {
    display: block;
    font-family: var(--serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--green-ink);
    margin-bottom: 0.7rem;
  }

  .reason__title {
    font-size: 1.1875rem;
    margin-bottom: 0.6rem;
  }

  .reason__text {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
</style>
