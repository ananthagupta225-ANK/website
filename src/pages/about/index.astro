---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Watermark from '../../components/Watermark.astro';
import Figure from '../../components/Figure.astro';
import { site, telLink } from '../../data/site';

const title = 'About ANK HR Services | HR and Payroll Support';
const description =
  'ANK HR Services is a professional HR consulting and services organisation providing payroll, compliance, HR operations, recruitment and workforce support.';
---

<Base title={title} description={description}>
  <PageHero
    label="About Us"
    title="About ANK HR Services"
    lead="A professional HR consulting and services organisation committed to providing comprehensive HR solutions to businesses."
    breadcrumbs={[{ label: 'About Us' }]}
  />

  <section class="section has-watermark">
    <Watermark position="top-right" size={480} opacity={0.04} tone="navy" />
    <div class="container">
      <div class="intro">
        <div class="intro__media" data-reveal="left">
          <Figure
            src="/images/about-ank.jpg"
            alt="An ANK HR Services consultant in a client meeting discussing HR and payroll requirements"
            ratio="1 / 1"
            label="About photograph — HR consultant with a client"
          />
        </div>

        <div class="intro__copy" data-reveal="right">
          <p class="label">Who we are</p>
          <h2>Simplifying complex HR processes</h2>
          <div class="prose">
            <p class="lead">
              We specialise in payroll management, statutory compliance, HR
              operations, recruitment, workforce management and labour law
              support.
            </p>
            <p>
              Our objective is to simplify complex HR processes through
              practical solutions, structured documentation and dependable
              professional support.
            </p>
            <p>
              Our approach begins with understanding the client’s business,
              workforce, current process and priorities. We then discuss the
              services required, agree on responsibilities, and work with the
              client’s team to coordinate the agreed deliverables — maintaining
              organised records and communicating clearly throughout.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--grey has-watermark">
    <Watermark position="bottom-left" size={420} opacity={0.04} tone="navy" />
    <div class="container">
      <div class="mv" data-stagger>
        <article class="mv__card" data-reveal="up">
          <p class="label">Our Mission</p>
          <p class="mv__text">
            To simplify HR management and statutory compliance through
            reliable, efficient and practical HR solutions.
          </p>
        </article>
        <article class="mv__card" data-reveal="up">
          <p class="label">Our Vision</p>
          <p class="mv__text">
            To become a trusted one-stop destination for comprehensive HR
            services and business workforce solutions.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div data-reveal="up">
          <p class="label">How we work</p>
          <h2>What you can expect from an engagement</h2>
        </div>
        <ul class="ticks expectations" data-reveal="up">
          <li>
            A conversation about your organisation, workforce and current
            process before anything is proposed.
          </li>
          <li>
            A written scope covering deliverables, responsibilities, the
            information we need from you and what is excluded.
          </li>
          <li>
            Agreed formats, checklists and trackers, so the same process runs
            the same way each cycle.
          </li>
          <li>
            Clear routes for questions, approvals and escalation, with a single
            point of coordination.
          </li>
          <li>
            Documents and outputs shared for your review and approval before
            they are issued or acted on.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight section--bordered">
    <div class="container">
      <div class="facts" data-reveal="up">
        <div class="facts__item">
          <p class="facts__label">Based in</p>
          <p class="facts__value">{site.locality}, {site.region}</p>
        </div>
        <div class="facts__item">
          <p class="facts__label">Service area</p>
          <p class="facts__value">{site.serviceArea}</p>
        </div>
        <div class="facts__item">
          <p class="facts__label">Business hours</p>
          <p class="facts__value">{site.hoursNote}, {site.hours}</p>
        </div>
        <div class="facts__item">
          <p class="facts__label">Speak to us</p>
          <p class="facts__value"><a href={telLink}>{site.phoneDisplay}</a></p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .intro {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 940px) {
    .intro {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .intro__copy .prose {
    margin-top: 1.35rem;
  }

  .mv {
    display: grid;
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 820px) {
    .mv {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mv__card {
    background: #fff;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .mv__text {
    font-family: var(--serif);
    font-size: clamp(1.125rem, 1.02rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    color: var(--navy);
  }

  .expectations li {
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .facts__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }

  .facts__value {
    font-family: var(--serif);
    font-size: 1.0625rem;
    color: var(--navy);
  }
</style>
