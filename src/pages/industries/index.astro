---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Watermark from '../../components/Watermark.astro';
import Figure from '../../components/Figure.astro';

const title = 'Industries We Serve | ANK HR Services';
const description =
  'HR, payroll and compliance support for corporate offices, manufacturing and factories, retail and hospitality, healthcare, IT & ITES and service organisations.';

const industries = [
  {
    n: '01',
    slug: 'corporate-offices',
    name: 'Corporate Offices',
    text: 'Structured HR administration, employee records, leave and attendance processes, and payroll coordination for office-based teams.',
    relevant: ['Payroll Management', 'HR Operations & Consultancy', 'HR Policies & Documentation'],
  },
  {
    n: '02',
    slug: 'manufacturing-factories',
    name: 'Manufacturing & Factories',
    text: 'Registers, licence and renewal documentation, workforce records, and inspection document organisation for factory environments.',
    relevant: ['Factory & Establishment Compliance', 'Contract Labour Management', 'PF, ESI & Labour Law Scrutiny Cases'],
  },
  {
    n: '03',
    slug: 'retail-hospitality',
    name: 'Retail & Hospitality',
    text: 'Consistent documentation and payroll inputs across branches and outlets, with one format applied at every location.',
    relevant: ['Payroll Management', 'HR Operations & Consultancy', 'Recruitment & Staffing'],
  },
  {
    n: '04',
    slug: 'healthcare-institutions',
    name: 'Healthcare & Institutions',
    text: 'Shift-based attendance, statutory records and employee lifecycle documentation for hospitals, clinics and institutions.',
    relevant: ['Payroll Management', 'PF, ESI & Labour Law Compliances', 'HR Policies & Documentation'],
  },
  {
    n: '05',
    slug: 'it-ites',
    name: 'IT & ITES',
    text: 'Recruitment coordination, onboarding and employee lifecycle support for teams that grow and change frequently.',
    relevant: ['Recruitment & Staffing', 'HR Operations & Consultancy', 'Payroll Management'],
  },
  {
    n: '06',
    slug: 'service-organisations',
    name: 'Service Organisations',
    text: 'Day-to-day HR operations, documentation and compliance coordination for service-sector and professional teams.',
    relevant: ['HR Operations & Consultancy', 'HR Policies & Documentation', 'PF, ESI & Labour Law Compliances'],
  },
];
---

<Base title={title} description={description}>
  <PageHero
    label="Industries"
    title="HR support for different business environments"
    lead="Every business has its own workforce and operating requirements. ANK HR Services can discuss support across different types of organisations, depending on the services needed and the agreed scope."
    breadcrumbs={[{ label: 'Industries' }]}
  />

  <section class="section has-watermark">
    <Watermark position="top-right" size={460} opacity={0.04} tone="navy" />
    <div class="container">
      <ul class="ind-list">
        {
          industries.map((i, idx) => (
            <li class="ind" data-reveal={idx % 2 === 0 ? 'left' : 'right'}>
              <div class="ind__media">
                <Figure
                  src={`/images/industries/${i.slug}.jpg`}
                  alt={`${i.name} — HR, payroll and compliance support from ANK HR Services`}
                  ratio="3 / 2"
                  label={i.name}
                />
              </div>
              <div class="ind__body">
                <span class="ind__num">{i.n}</span>
                <h2 class="ind__name">{i.name}</h2>
                <p class="ind__text">{i.text}</p>
                <p class="ind__label">Commonly relevant services</p>
                <ul class="ind__tags">
                  {i.relevant.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="ind-note" data-reveal="up">
        <p>
          This is a guide to the business environments we can discuss, not a
          claim of specialist experience in any particular sector. Whether we
          can support a specific requirement depends on the services involved
          and the scope agreed with you.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Does your organisation fit one of these?"
    text="Even if it doesn’t, tell us how your workforce is structured and what you need coordinated. We’ll let you know what we can support."
  />
</Base>

<style>
  .ind-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ind {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--line);
    align-items: center;
  }

  .ind:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 880px) {
    .ind {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    }
    /* Alternate the photograph side down the page. */
    .ind:nth-child(even) .ind__media {
      order: 2;
    }
  }

  .ind__num {
    display: block;
    font-family: var(--serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--green-ink);
    margin-bottom: 0.6rem;
  }

  .ind__name {
    font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.55rem);
    margin-bottom: 0.75rem;
  }

  .ind__text {
    color: var(--ink-2);
    max-width: 62ch;
  }

  .ind__label {
    margin-top: 1.35rem;
    margin-bottom: 0.65rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ind__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .ind__tags li {
    font-size: 0.8125rem;
    padding: 0.3rem 0.7rem;
    background: var(--grey);
    border: 1px solid var(--line);
    border-radius: 100px;
    color: var(--ink-2);
  }

  .ind-note {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: 1.35rem 1.5rem;
    background: var(--grey);
    border-left: 3px solid var(--orange);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .ind-note p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 78ch;
  }
</style>
