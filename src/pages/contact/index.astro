---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Watermark from '../../components/Watermark.astro';
import { site, telLink, mailLink, whatsappLink } from '../../data/site';
import { href, abs } from '../../lib/url';

const title = 'Contact ANK HR Services';
const description =
  'Contact ANK HR Services in Hyderabad to discuss payroll, HR operations, documentation, recruitment or compliance support. Call +91 97003 69225 or enquire online.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    url: abs('/contact/', Astro.site),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <PageHero
    label="Contact"
    title="Let’s talk about your HR requirements"
    lead="Looking for support with payroll, HR operations, employee documentation, recruitment or statutory compliance coordination? Tell us a little about your organisation and we’ll review your enquiry and come back to you."
    breadcrumbs={[{ label: 'Contact' }]}
  />

  <section class="section has-watermark">
    <Watermark position="top-right" size={470} opacity={0.04} tone="navy" />
    <div class="container">
      <div class="contact">
        <div class="contact__form" data-reveal="up">
          <EnquiryForm />
        </div>

        <aside class="contact__aside" data-reveal="right">
          <div class="contact-card">
            <h2>Speak to us directly</h2>
            <ul class="contact-list">
              <li>
                <span class="contact-list__label">Phone</span>
                <a class="contact-list__value" href={telLink}>
                  {site.phoneDisplay}
                </a>
              </li>
              <li>
                <span class="contact-list__label">WhatsApp</span>
                <a class="contact-list__value" href={whatsappLink} rel="noopener">
                  Message {site.phoneDisplay}
                </a>
              </li>
              {
                !site.emailIsPlaceholder && (
                  <li>
                    <span class="contact-list__label">Email</span>
                    <a class="contact-list__value" href={mailLink}>
                      {site.email}
                    </a>
                  </li>
                )
              }
              <li>
                <span class="contact-list__label">Office</span>
                <span class="contact-list__value">{site.addressLine}</span>
              </li>
              <li>
                <span class="contact-list__label">Service area</span>
                <span class="contact-list__value">{site.serviceArea}</span>
              </li>
              <li>
                <span class="contact-list__label">Hours</span>
                <span class="contact-list__value">
                  {site.hoursNote}, {site.hours}
                </span>
              </li>
            </ul>
          </div>

          <div class="contact-card contact-card--muted">
            <h2>What happens next</h2>
            <ol class="next-steps">
              <li>We review your enquiry and the areas of support you selected.</li>
              <li>
                We contact you using the details provided to understand the
                requirement in more detail.
              </li>
              <li>
                Where there is a fit, we propose a scope covering deliverables,
                responsibilities and commercials.
              </li>
            </ol>
            <p class="small text-muted">
              Details you send are used only to respond to your enquiry. See our
              <a href={href('/privacy-policy/')}>Privacy Policy</a>.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) 20.5rem;
    }
    .contact__aside {
      position: sticky;
      top: 7.5rem;
    }
  }

  .contact-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .contact-card + .contact-card {
    margin-top: 1.25rem;
  }

  .contact-card h2 {
    font-size: 1.0625rem;
    margin-bottom: 1.1rem;
  }

  .contact-card--muted {
    background: var(--grey);
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-list li {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
  }

  .contact-list li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .contact-list__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact-list__value {
    font-size: 0.9375rem;
    color: var(--navy);
    font-weight: 500;
  }

  a.contact-list__value {
    text-decoration: none;
  }

  a.contact-list__value:hover {
    text-decoration: underline;
  }

  .next-steps {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .next-steps li + li {
    margin-top: 0.6rem;
  }

  .contact-card .small {
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
  }
</style>
