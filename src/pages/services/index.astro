---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Watermark from '../../components/Watermark.astro';
import Figure from '../../components/Figure.astro';
import { services } from '../../data/services';
import { href, abs } from '../../lib/url';

const title = 'HR, Payroll & Compliance Services | ANK HR Services';
const description =
  'Eight HR service areas from ANK HR Services: payroll, PF and ESI, HR operations, policies, recruitment, factory compliance, contract labour and scrutiny cases.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'ANK HR Services — services',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
      url: abs(`/services/${s.slug}/`, Astro.site),
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <PageHero
    label="Our Services"
    title="Eight HR service areas, one partner"
    lead="Explore the HR, payroll, recruitment, documentation and compliance support offered by ANK HR Services. The exact scope is discussed based on your organisation, workforce, locations and applicable requirements."
    breadcrumbs={[{ label: 'Our Services' }]}
  />

  <section class="section has-watermark">
    <Watermark position="top-right" size={480} opacity={0.04} tone="navy" />
    <div class="container">
      <ol class="svc-list">
        {
          services.map((s, idx) => (
            <li class="svc-row" data-reveal={idx % 2 === 0 ? 'left' : 'right'}>
              <div class="svc-row__media">
                <a href={href(`/services/${s.slug}/`)} aria-label={s.title}>
                  <Figure
                    src={s.image}
                    alt={`${s.title} — ANK HR Services`}
                    ratio="3 / 2"
                    label={s.title}
                  />
                </a>
              </div>

              <div class="svc-row__body">
                <span class="svc-row__num">Service {s.number}</span>
                <h2 class="svc-row__title">
                  <a href={href(`/services/${s.slug}/`)}>{s.title}</a>
                </h2>
                <p class="svc-row__lead">{s.summary}</p>

                <p class="svc-row__label">What is typically included</p>
                <ul class="ticks ticks--two">
                  {s.activities.slice(0, 4).map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>

                <a class="arrow-link svc-row__cta" href={href(`/services/${s.slug}/`)}>
                  Learn More about {s.short}
                </a>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="scope-note--page" data-reveal="up">
        <h2>A note on scope</h2>
        <p>
          Service availability and deliverables are confirmed individually with
          each client. Requirements vary by establishment, location, workforce
          and the law in force at the time, so the activities listed here
          describe the support we can provide rather than a fixed package.
          Responsibilities, approvals, exclusions and commercials are set out in
          the engagement before work begins.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .svc-row {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .svc-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  @media (min-width: 900px) {
    .svc-row {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    }
    .svc-row:nth-child(even) .svc-row__media {
      order: 2;
    }
  }

  .svc-row__media a {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .svc-row__num {
    display: block;
    font-family: var(--serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--green-ink);
    margin-bottom: 0.6rem;
  }

  .svc-row__title {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    margin-bottom: 0.75rem;
  }

  .svc-row__title a {
    text-decoration: none;
  }

  .svc-row__title a:hover {
    text-decoration: underline;
  }

  .svc-row__lead {
    color: var(--ink-2);
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .svc-row__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .svc-row .ticks li {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .svc-row__cta {
    margin-top: 1.5rem;
  }

  .scope-note--page {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--grey);
    border-left: 3px solid var(--orange);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .scope-note--page h2 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .scope-note--page p {
    font-size: 0.9375rem;
    max-width: 78ch;
  }
</style>
